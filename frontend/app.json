{
  "expo": {
    "name": "FlashKu",
    "slug": "flashku-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flashku",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.logicodix.flashku",
      "adaptiveIcon": {
        "backgroundColor": "#7A39FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B5BF0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B5BF0"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android",
      "web"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "929291d5-bd57-4b74-b268-30e05cd376b3"
      }
    }
  }
}
